# SevaSetu Backend Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=3001
NODE_ENV=development

# Firebase Admin SDK
# Option A: use service account fields directly
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# Option B: use a local service account JSON path instead of Option A
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# Google Cloud Storage
GCS_BUCKET_NAME=your-project-id.appspot.com

# Vertex AI / Gemini
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Rate limiting
# Window duration in milliseconds (default 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Global API max requests per window per IP
RATE_LIMIT_MAX=300
# Auth API max requests per window per IP
RATE_LIMIT_AUTH_MAX=20
# Upload API max requests per window per IP
RATE_LIMIT_UPLOAD_MAX=30
# AI API max requests per window per IP (classification + gemini)
RATE_LIMIT_AI_MAX=60

# WhatsApp (Twilio) - For future implementation
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
