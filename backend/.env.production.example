PORT=3001
NODE_ENV=production

ALLOWED_ORIGINS=https://sevasetu.vercel.app

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GCS_BUCKET_NAME=your-project-id.appspot.com

GEMINI_API_KEY=your-gemini-api-key
GEMINI_FLASH_MODEL=gemini-3.1-flash-lite-preview
GEMINI_PRO_MODEL=gemini-3-flash-preview

ALLOW_LOCAL_UPLOAD_FALLBACK=false
ENABLE_RUNTIME_SCHEDULERS=true

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_AI_MAX=60
