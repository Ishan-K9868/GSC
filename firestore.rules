rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Hackathon prototype rules:
    // - Public read access for live demo surfaces that query Firestore directly
    // - Writes remain auth-only from the client side
    // - Admin SDK backend bypasses these rules as usual

    match /needReports/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /volunteers/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /dispatchTasks/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
